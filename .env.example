# OnCell — the agent cloud kaka runs on (https://oncell.ai)
# Create an API key in the OnCell dashboard.
ONCELL_API_KEY=oncell_sk_...
ONCELL_API_URL=https://api.oncell.ai

# Optional: only needed for KAKA_BUILDER_MODE=local (the default "agent"
# mode runs the Builder on OnCell, metered through its LLM gateway).
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Cognito auth for the web app (omit all three for local mode —
# no sign-in gate). Deploy infra/'s AuthStack to get these values.
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=
# NEXT_PUBLIC_AWS_REGION=us-east-1
