{
  "name": "@platform/registry",
  "version": "0.1.0",
  "private": true,
  "description": "Venture registry service: CRUD over venture records (manifest per contracts/venture/venture.schema.json) behind capability-token authorization; every mutation lands on the platform event bus (EXECUTION.md M0 item 5).",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
